{
  "name": "agent-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, evidence-driven autonomous coding loop (beta). The agent is a worker; objective runtime evidence is the source of truth.",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "agent-loop": "dist/bin/agent-loop.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "agent-loop": "node --no-warnings=ExperimentalWarning --import tsx bin/agent-loop.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/bin/agent-loop.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node --no-warnings=ExperimentalWarning --import tsx bin/agent-loop.ts demo",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "eslint": "9.18.0",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
