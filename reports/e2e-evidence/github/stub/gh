#!/usr/bin/env bash
# Hermetic gh stub. Records every invocation to $GH_STUB_LOG.
# Log format: one line per call. argv joined by literal ' <|> ' so multi-line
# --body never splits the record (newlines flattened to the token).
LOG="${GH_STUB_LOG:-/tmp/gh-stub.log}"
# Build a single-line record of all args with newlines flattened.
rec=""
for a in "$@"; do
  flat="$(printf '%s' "$a" | tr '\n\r' '  ')"
  if [ -z "$rec" ]; then rec="$flat"; else rec="$rec <|> $flat"; fi
done
printf '%s\n' "$rec" >> "$LOG"

# Also dump the raw --body to a file so we can inspect the PR description verbatim.
prev=""
for a in "$@"; do
  if [ "$prev" = "--body" ]; then printf '%s' "$a" > "${GH_STUB_BODYFILE:-/tmp/gh-stub-body.txt}"; fi
  prev="$a"
done

verb="$1 $2"
case "$verb" in
  "pr list")
    if [ "$GH_STUB_EXISTING" = "1" ]; then
      printf '%s\n' '[{"url":"https://github.com/o/r/pull/7"}]'
    else
      printf '%s\n' '[]'
    fi
    ;;
  "pr create")
    printf '%s\n' "https://github.com/o/r/pull/42"
    ;;
  "issue view")
    printf '%s\n' '{"title":"Add CSV export","body":"Export rows.\n- [ ] add button\n- [x] write encoder","comments":[{"author":{"login":"alice"},"body":"add tests please"}]}'
    ;;
  *)
    printf '%s\n' "{}"
    ;;
esac
exit 0
