+'use strict';
+
+// Billing settings domain logic with validation.
+const PLANS = ['free', 'pro', 'enterprise'];
+
+function validateBillingSettings(input) {
+  const errors = [];
+  if (!input || typeof input !== 'object') {
+    return { valid: false, errors: ['settings must be an object'] };
+  }
+  if (!PLANS.includes(input.plan)) {
+    errors.push(`plan must be one of: ${PLANS.join(', ')}`);
+  }
+  if (typeof input.seats !== 'number' || !Number.isInteger(input.seats) || input.seats < 1) {
+    errors.push('seats must be a positive integer');
+  }
+  if (input.email !== undefined && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(String(input.email))) {
+    errors.push('email must be valid');
+  }
+  return { valid: errors.length === 0, errors };
+}
+
+function renderBillingSettingsPage(settings) {
+  const v = validateBillingSettings(settings);
+  if (!v.valid) {
+    return { status: 400, body: { error: 'invalid billing settings', details: v.errors } };
+  }
+  return {
+    status: 200,
+    body: { plan: settings.plan, seats: settings.seats, email: settings.email ?? null }
+  };
+}
+
+module.exports = { validateBillingSettings, renderBillingSettingsPage, PLANS };
diff --git a/test/billing.test.js b/test/billing.test.js
new file mode 100644
index 0000000..b90f494
--- /dev/null
+++ b/test/billing.test.js
@@ -0,0 +1,39 @@
+'use strict';
+const assert = require('node:assert');
+const test = require('node:test');
+const { validateBillingSettings, renderBillingSettingsPage } = require('../src/billing.js');
+
+test('valid billing settings pass', () => {
+  const v = validateBillingSettings({ plan: 'pro', seats: 5, email: 'a@b.com' });
+  assert.strictEqual(v.valid, true);
+  assert.deepStrictEqual(v.errors, []);
+});
+
+test('invalid plan rejected', () => {
+  const v = validateBillingSettings({ plan: 'gold', seats: 5 });
+  assert.strictEqual(v.valid, false);
+  assert.ok(v.errors.some((e) => e.includes('plan')));
+});
+
+test('non-positive seats rejected', () => {
+  const v = validateBillingSettings({ plan: 'free', seats: 0 });
+  assert.strictEqual(v.valid, false);
+  assert.ok(v.errors.some((e) => e.includes('seats')));
+});
+
+test('bad email rejected', () => {
+  const v = validateBillingSettings({ plan: 'free', seats: 1, email: 'nope' });
+  assert.strictEqual(v.valid, false);
+});
+
+test('render returns 200 for valid settings', () => {
+  const r = renderBillingSettingsPage({ plan: 'enterprise', seats: 50 });
+  assert.strictEqual(r.status, 200);
+  assert.strictEqual(r.body.plan, 'enterprise');
+});
+
+test('render returns 400 for invalid settings', () => {
+  const r = renderBillingSettingsPage({ plan: 'bad', seats: -1 });
+  assert.strictEqual(r.status, 400);
+  assert.ok(Array.isArray(r.body.details));
+});
